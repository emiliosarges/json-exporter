DB_USER=admin
DB_PASSWORD=1234
DB_POOL_SIZE=5

EXPORT_OUTPUT_DIR=./output
EXPORT_PAGE_SIZE=2000
EXPORT_MAX_RECORDS_PER_FILE=100000
EXPORT_MAX_FILE_SIZE_MB=250
EXPORT_SIZE_CHECK_INTERVAL=500

DELIVERY_MODE=LOCAL

SFTP_HOST=localhost
SFTP_PORT=22
SFTP_USER=usuario
SFTP_PASSWORD=senha
SFTP_REMOTE_DIRECTORY=/upload
SFTP_ALLOW_UNKNOWN_KEYS=false

# Banco MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rico
DB_USER=root
DB_PASSWORD=1234
DB_POOL_SIZE=5

# Exportacao
EXPORT_OUTPUT_DIR=./output
EXPORT_PAGE_SIZE=2000
EXPORT_MAX_RECORDS_PER_FILE=10000
EXPORT_MAX_FILE_SIZE_MB=5
EXPORT_SIZE_CHECK_INTERVAL=500

# Destino: LOCAL ou SFTP
DELIVERY_MODE=LOCAL

# SFTP - usado somente quando DELIVERY_MODE=SFTP
SFTP_HOST=localhost
SFTP_PORT=22
SFTP_USER=usuario
SFTP_PASSWORD=senha
SFTP_REMOTE_DIRECTORY=/upload
SFTP_ALLOW_UNKNOWN_KEYS=true

